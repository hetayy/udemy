  "instructions": [
    {
      "step": 1,
      "text": "In a medium size bowl, whisk together corn starch and water. Add remaining ingredients (chicken broth, soy sauce, honey, toasted sesame oil, and red pepper flakes) and whisk to combine. Set aside."
    },
    {
      "step": 2,
      "text": "Add one tablespoon of olive oil to a large skillet or wok and heat over medium high heat."
    },
    {
      "step": 3,
      "text": "Add chicken, in batches if necessary, and season with salt and pepper. Cook for 3 to 5 minutes or until cooked through. Remove from skillet."
    },
    {
      "step": 4,
      "text": "Reduce heat to medium and add remaining tablespoon of oil to the skillet."
    },
    {
      "step": 5,
      "text": "Add broccoli, bell pepper, and carrots and cook, stirring occasionally, just until crisp tender. Add ginger and garlic and cook for an additional minute."
    },
    {
      "step": 6,
      "text": "Add chicken back into the skillet and stir to combine."
    },
    {
      "step": 7,
      "text": "Whisk stir fry sauce and pour over chicken and vegetables and stir gently to combine."
    },
    {
      "step": 8,
      "text": "Bring to a boil, stirring occasionally, and let boil for one minute."
    },
    {
      "step": 9,
      "text": "Serve with rice and/or chow mein if desired."
    }
  ],

